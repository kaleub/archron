---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Layout title="field notes">
<section>
  <div class="container--base">
    <div>
      <h1 class="home--heading-1">field notes</h1>
      <p>Notes and artifacts, an attempt at a more humanist internet and other esoteric bullshit.</p>
    </div>
    <div class="home--notes-list">
      {posts.map((post) => (
        <div class="home--list-item">
          <a href={`/notes/${post.id}`}>{post.data.title}</a>
          <time class="home--list-item--time">{post.data.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            timeZone: 'UTC',
          })
          }</time>
        </div>
      ))}
    </div>
  </div>
</section>
</Layout>